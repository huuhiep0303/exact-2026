# Runtime mode: mock | local | api
PIPELINE_MODE=api
DEBUG=false

# OpenAI-compatible vLLM server used by submission/app.py and the Type 2 reasoner.
VLLM_API_URL=https://m3pminh15112005--exact-2026-vllm-serve.modal.run/v1
MODEL_NAME=Qwen/Qwen3-8B
TYPE1_MODEL=exact-lora
TYPE2_MODEL=exact-lora-type2

# Keep internal budgets below the organizer's 60-second request timeout.
VLLM_REQUEST_TIMEOUT=45
TYPE1_MAX_TOKENS=512
TYPE2_PIPELINE_TIMEOUT=50
REASONER_API_TIMEOUT=40

# Type 2 reasoner settings.
OPENAI_API_KEY=not-needed
OPENAI_BASE_URL=https://m3pminh15112005--exact-2026-vllm-serve.modal.run/v1
REASONER_API_MODEL=exact-lora-type2
REASONER_MODEL=qwen2.5:7b
REASONER_MAX_TOKENS=512
REASONER_TEMPERATURE=0.1

# Optional Qdrant RAG backend. Set USE_QDRANT=false for in-memory BM25 only.
USE_QDRANT=false
QDRANT_HOST=https://YOUR-QDRANT-HOST
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=physics_kb

# Optional Redis cache.
USE_REDIS=false
REDIS_HOST=localhost

# Optional Hugging Face credentials for model download and fine-tuning.
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN
HUGGINGFACE_HUB_TOKEN=YOUR_HUGGING_FACE_TOKEN

# Structurer settings retained for local pipeline compatibility.
STRUCTURER_MODEL=Qwen/Qwen2.5-7B-Instruct
STRUCTURER_MAX_TOKENS=256
STRUCTURER_TEMPERATURE=0.0
